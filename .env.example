# Copy to .env and supply credentials locally or through your deployment's
# secret manager. Never commit .env or paste credential values into chat.
OPENAI_API_KEY=
FB_PAGE_ACCESS_TOKEN=
# Choose a long random shared verification string; this is not the app secret.
FB_VERIFY_TOKEN=
FB_APP_SECRET=

# Recommended: restrict this single-Page agent to your numeric Page ID.
FB_PAGE_ID=
OPENAI_MODEL=gpt-4o-mini
# Use a version still supported by your Meta app (v20.0 or newer).
FB_GRAPH_VERSION=v24.0

# Keep true until you have reviewed real comment decisions.
# Dry-run still calls OpenAI, but makes no Meta action requests.
DRY_RUN=true
WORKER_COUNT=2
QUEUE_CAPACITY=10000
API_TIMEOUT_SECONDS=20
# Optional overrides; defaults are relative to the app directory.
# INBOX_PATH=.local/moderation.sqlite3
# MODERATION_LOG_PATH=webhook_moderation.log
# MAX_BODY_BYTES=1048576
